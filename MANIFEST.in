include LICENSE CITATION.cff CHANGELOG.md
recursive-include docs *.md
recursive-include examples *.py
recursive-include tests *.py
recursive-include bench *.py *.md *.json
recursive-include numerical_case *.py *.md *.csv *.json *.svg *.pdf
prune numerical_case/results
prune numerical_case/raw_data
prune numerical_case/certificates
global-exclude __pycache__ *.py[cod] .DS_Store
